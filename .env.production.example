# Shared
NODE_ENV="production"

# Server
PORT=4000
CLIENT_URL="https://your-travelverse-client.example.com"
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER/travelverse?retryWrites=true&w=majority"
MONGODB_DB_NAME="travelverse"
JWT_SECRET="replace-with-at-least-32-random-characters"
LOG_FORMAT="json"
SERVICE_VERSION="0.1.0"
RELEASE_SHA="set-from-git-commit-sha"
TRUST_PROXY_HOPS=1
SENTRY_DSN=""

# Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://your-travelverse-api.example.com/api/auth/google/callback"
OAUTH_SUCCESS_REDIRECT_URL="https://your-travelverse-client.example.com/account"
OAUTH_FAILURE_REDIRECT_URL="https://your-travelverse-client.example.com/login?oauth=failed"
ADMIN_EMAIL="admin@your-domain.example"
ADMIN_NAME="TravelVerse Admin"
ADMIN_PASSWORD="replace-before-production-seeding"

# External providers
INGESTION_USER_AGENT="TravelVerse3D/0.1 (production; admin@your-domain.example)"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
WIKIPEDIA_API_BASE_URL="https://en.wikipedia.org"
OSRM_BASE_URL="https://router.project-osrm.org"
PROVIDER_DAILY_REQUEST_LIMIT=500
PROVIDER_MONTHLY_BUDGET_INR=0
INGESTION_FETCH_TIMEOUT_MS=6000
INGESTION_CACHE_TTL_SECONDS=21600
ROUTING_FETCH_TIMEOUT_MS=7000
ROUTING_CACHE_TTL_SECONDS=900

# Client
NEXT_PUBLIC_API_URL="https://your-travelverse-api.example.com/api"
