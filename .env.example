# Shared
NODE_ENV="development"

# Server
PORT=4000
CLIENT_URL="http://localhost:3000"
MONGODB_URI="mongodb://travelverse:travelverse@localhost:27017/travelverse?authSource=admin"
MONGODB_DB_NAME="travelverse"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
OAUTH_SUCCESS_REDIRECT_URL="http://localhost:3000/account"
OAUTH_FAILURE_REDIRECT_URL="http://localhost:3000/login?oauth=failed"
ADMIN_EMAIL="admin@travelverse.local"
ADMIN_NAME="TravelVerse Admin"
ADMIN_PASSWORD="Admin@12345"
INGESTION_USER_AGENT="TravelVerse3D/0.1 (local demo; admin@travelverse.local)"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
WIKIPEDIA_API_BASE_URL="https://en.wikipedia.org"
OSRM_BASE_URL="https://router.project-osrm.org"
ROUTING_FETCH_TIMEOUT_MS=7000
ROUTING_CACHE_TTL_SECONDS=900

# Client
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# External provider keys for later days
MAPTILER_API_KEY=""
OPENWEATHER_API_KEY=""
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
HOTEL_PROVIDER_API_KEY=""
OPENAI_API_KEY=""
