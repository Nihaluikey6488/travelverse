{
  "name": "travelverse-3d",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:client": "pnpm --filter @travelverse/client dev",
    "dev:server": "pnpm --filter @travelverse/server dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:seed": "pnpm --filter @travelverse/server db:seed"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3"
    }
  }
}
